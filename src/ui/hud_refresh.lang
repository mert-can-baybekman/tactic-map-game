  // KINETIC GPU CAMERA INTERPOLATOR
  fn InterpolateCameraGlide(start_x: Float, start_y: Float, start_zoom: Float,
                            dest: CameraFocusVector, progress_t: Float) -> (Float, Float, Float) {
    // Standard Cubic Out Easing: f(t) = 1 - (1 - t)^3
    let inv_t: Float = 1.0 - progress_t;
    let factor: Float = 1.0 - (inv_t * inv_t * inv_t);

    let cur_zoom: Float = start_zoom + (dest.target_zoom - start_zoom) * factor;
    let canvas_center_x: Float = 2000.0 / 2.0;
    let canvas_center_y: Float = 1100.0 / 2.0;

    let dest_pan_x: Float = canvas_center_x - (dest.target_x * cur_zoom);
    let dest_pan_y: Float = canvas_center_y - (dest.target_y * cur_zoom);

    let cur_pan_x: Float = start_x + (dest_pan_x - start_x) * factor;
    let cur_pan_y: Float = start_y + (dest_pan_y - start_y) * factor;

    return (cur_pan_x, cur_pan_y, cur_zoom);
  }

  // STATE-REACTIVE BLOCKADE VISUAL DISPATCHER
  fn UpdateBlockadeCorridors(payload: BlockadeVisualPayload) {
    if (payload.channel_blockaded) {
      SetLineStyle("dover-calais-line", payload.interdiction_crimson, true);
      SetLineStyle("sea-trade-line", payload.interdiction_crimson, true);
      SetLineStyle("gibraltar-maritime-loop", payload.interdiction_crimson, true);
    } else {
      SetLineStyle("dover-calais-line", payload.primary_tint_hex, false);
      SetLineStyle("sea-trade-line", payload.primary_tint_hex, false);
      SetLineStyle("gibraltar-maritime-loop", payload.primary_tint_hex, false);
    }

    if (payload.strait_blockaded) {
      SetLineStyle("bosphorus-strait-line", payload.interdiction_crimson, true);
      SetElementClass("bosphorus-choke-indicator", "blockaded", true);
    } else {
      SetLineStyle("bosphorus-strait-line", "#00e5ff", false);
      SetElementClass("bosphorus-choke-indicator", "blockaded", false);
    }
  }

  // REFRESH FOOTER TELEMETRY LEDGER
  fn RefreshFooterStats(location_id: Int, control_pct: Float, devastation_pct: Float, pops_count: Int) {
    let stats_text: String = "Control: " + FormatFixed(control_pct * 100.0, 1) + "% • " +
                             "Devastation: " + FormatFixed(devastation_pct * 100.0, 1) + "% • " +
                             "Pops: " + FormatThousands(pops_count);
    UpdateDomElement("selected-loc-stats", stats_text);
  }
}
